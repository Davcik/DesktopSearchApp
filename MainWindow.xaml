<Window x:Class="DesktopSearchApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopSearchApp"
        Height="860"
        Width="1420"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="DesktopSearchApp"
                               Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Advanced document search for Word, PDF, images, spreadsheets, code, research files, and PowerPoint"
                               Style="{StaticResource BodyText}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox x:Name="SearchBox"
                             Width="460"
                             Margin="20,0,12,0"
                             VerticalContentAlignment="Center" />
                    <Button x:Name="SearchButton"
                            Width="120"
                            Content="Search"
                            Click="SearchButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Folder / indexing toolbar -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SelectFolderButton"
                        Width="170"
                        Margin="0,0,12,0"
                        Content="Select Folder"
                        Click="SelectFolderButton_Click" />
                <Button x:Name="BuildIndexButton"
                        Width="170"
                        Margin="0,0,12,0"
                        Content="Build Index"
                        Click="BuildIndexButton_Click" />
                <TextBlock x:Name="SelectedFolderText"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyText}"
                           Text="No folder selected" />
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Filters -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Filters"
                               Style="{StaticResource SectionTitleText}" />

                    <TextBlock Text="File type"
                               Margin="0,18,0,10"
                               FontWeight="SemiBold" />
                    <CheckBox x:Name="WordCheckBox"
                              Content="Word (.docx, .doc)"
                              IsChecked="False"/>
                    <CheckBox x:Name="PdfCheckBox"
                              Content="PDF (.pdf)"
                              IsChecked="False"/>
                    <CheckBox x:Name="ImageCheckBox"
                              Content="Images (.jpg, .jpeg, .png)"
                              IsChecked="False"/>
                    <CheckBox x:Name="TextCheckBox"
                              Content="Text / research / code files"
                              IsChecked="False"/>
                    <CheckBox x:Name="PptxCheckBox"
                              Content="PowerPoint (.pptx)"
                              IsChecked="False"/>

                    <TextBlock Text="Search scope"
                               Margin="0,18,0,10"
                               FontWeight="SemiBold" />
                    <RadioButton x:Name="AllFieldsRadio"
                                 Content="All fields"
                                 GroupName="Scope"
                                 IsChecked="True"/>
                    <RadioButton x:Name="TitleOnlyRadio"
                                 Content="Title only"
                                 GroupName="Scope"/>
                    <RadioButton x:Name="DocumentTextRadio"
                                 Content="Document text"
                                 GroupName="Scope"/>
                </StackPanel>
            </Border>

            <!-- Results -->
            <Border Grid.Column="1"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Results"
                               Style="{StaticResource SectionTitleText}" />

                    <DataGrid x:Name="ResultsGrid"
                              Grid.Row="1"
                              Margin="0,16,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              RowHeight="38"
                              AlternationCount="2"
                              RowBackground="White"
                              AlternatingRowBackground="#F7FCFC"
                              BorderBrush="{StaticResource BrushBorder}"
                              BorderThickness="1"
                              SelectionChanged="ResultsGrid_SelectionChanged"
                              MouseDoubleClick="ResultsGrid_MouseDoubleClick">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File Name"
                                                Binding="{Binding FileName}"
                                                Width="200" />

                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding Extension}"
                                                Width="75" />

                            <DataGridTextColumn Header="Last Saved"
                                                Binding="{Binding LastModified, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                Width="150" />

                            <DataGridTextColumn Header="Title"
                                                Binding="{Binding Title}"
                                                Width="280" />

                            <DataGridTextColumn Header="Snippet"
                                                Binding="{Binding Snippet}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Preview + Diagnostics -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Preview -->
                <Border Grid.Row="0"
                        Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Preview"
                                       Style="{StaticResource SectionTitleText}" />

                            <TextBlock x:Name="PreviewTitle"
                                       Margin="0,16,0,10"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Text="No document selected" />

                            <TextBlock x:Name="PreviewText"
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       Text="Select a result to see title, file path, and text preview. Double-click a result to open the document." />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Row="1"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="#D9E6E8"
                              ShowsPreview="True"
                              ResizeDirection="Rows" />

                <!-- Diagnostics -->
                <Border Grid.Row="2"
                        Style="{StaticResource CardBorderStyle}"
                        Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <TextBlock Text="Diagnostics Log"
                                       Style="{StaticResource SectionTitleText}" />

                            <Button x:Name="ClearDiagnosticsButton"
                                    DockPanel.Dock="Right"
                                    Width="110"
                                    Margin="12,0,0,0"
                                    Content="Clear Log"
                                    Click="ClearDiagnosticsButton_Click" />
                        </DockPanel>

                        <ListBox x:Name="DiagnosticsListBox"
                                 Grid.Row="1"
                                 Margin="0,16,0,0"
                                 ItemsSource="{Binding DiagnosticsEntries}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E3ECEE"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,6">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />
                                                <Run Text="  " />
                                                <Run Text="{Binding Level}" />
                                            </TextBlock>

                                            <TextBlock Text="{Binding Message}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />

                                            <TextBlock Text="{Binding FilePath}"
                                                       Foreground="#5E7377"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3"
                Background="{StaticResource BrushPrimarySoft}"
                CornerRadius="12"
                Padding="12"
                Margin="0,16,0,0">
            <TextBlock x:Name="StatusText"
                       Text="Status: ready"
                       Foreground="{StaticResource BrushPrimaryDark}"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>